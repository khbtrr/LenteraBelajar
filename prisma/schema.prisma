generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model School {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  logo        String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Standar Akademik Default
  defaultPassingGrade  Float?   @default(75)

  // Default Keamanan & Pengaturan CBT
  cbtLockdownEnabled   Boolean  @default(true)
  cbtMaxTabSwitches    Int      @default(3)
  cbtRequireToken      Boolean  @default(false)
  cbtShuffleQuestions  Boolean  @default(false)
  cbtShuffleOptions    Boolean  @default(false)

  users          User[]
  academicYears  AcademicYear[]
  categories     Category[]
  courses        Course[]
  cohorts        Cohort[]
  courseRequests CourseRequest[]
  schoolAnnouncements SchoolAnnouncement[]
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  nis              String?  // Nomor Induk Siswa (student ID)
  nip              String?  // Nomor Induk Pegawai (staff ID)
  role             Role
  avatar           String?
  isActive         Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  locale           String   @default("id")
  schoolId         String?
  failedLoginAttempts Int    @default(0)
  lockoutCount        Int    @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  xp               Int                  @default(0)
  level            Int                  @default(1)
  streakDays       Int                  @default(0)
  lastActiveDate   DateTime?

  school                School?              @relation(fields: [schoolId], references: [id])
  teacherCourses        Course[]             @relation("CourseTeacher")
  enrollments           Enrollment[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  grades                Grade[]
  notifications         Notification[]
  cohortMemberships     CohortMember[]
  courseRequests        CourseRequest[]
  attendanceRecords     AttendanceRecord[]
  courseAnnouncements   CourseAnnouncement[]
  announcementComments  AnnouncementComment[]
  forumThreads          ForumThread[]
  forumComments         ForumComment[]
  achievements          UserAchievement[]
  xpLogs                XpLog[]
  lessonProgresses      LessonProgress[]
  calendarEvents        CalendarEvent[]
  schoolAnnouncements   SchoolAnnouncement[]
  conversationParticipants ConversationParticipant[]
  sentDirectMessages      DirectMessage[]           @relation("DirectMessageSender")
  auditLogs               AuditLog[]

  @@index([schoolId])
  @@index([email])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  TEACHER
  STUDENT
}

model AcademicYear {
  id        String             @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(ACTIVE)
  schoolId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  school    School    @relation(fields: [schoolId], references: [id])
  courses   Course[]

  @@index([schoolId])
}

enum AcademicYearStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  parentId  String?
  schoolId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  school    School     @relation(fields: [schoolId], references: [id])
  courses   Course[]

  @@index([schoolId])
  @@index([parentId])
}

model Course {
  id              String       @id @default(cuid())
  title           String
  description     String?
  status          CourseStatus @default(DRAFT)
  schoolId        String
  teacherId       String
  categoryId      String?
  academicYearId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  teacher      User         @relation("CourseTeacher", fields: [teacherId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  modules                Module[]
  enrollments            Enrollment[]
  grades                 Grade[]
  questionBank           QuestionBank[]
  questionBankCategories QuestionBankCategory[]
  attendanceSessions     AttendanceSession[]
  announcements          CourseAnnouncement[]
  forumThreads           ForumThread[]
  calendarEvents         CalendarEvent[]

  @@index([schoolId])
  @@index([teacherId])
  @@index([academicYearId])
}

enum CourseStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
}

model CourseRequest {
  id              String              @id @default(cuid())
  title           String
  description     String?
  categoryId      String?
  academicYearId  String
  requesterId     String
  status          CourseRequestStatus  @default(PENDING)
  adminNote       String?
  courseId         String?
  schoolId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requester  User   @relation(fields: [requesterId], references: [id])
  school     School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([requesterId])
}

enum CourseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School         @relation(fields: [schoolId], references: [id])
  members     CohortMember[]
  enrollments Enrollment[]

  @@index([schoolId])
}

model CohortMember {
  id        String   @id @default(cuid())
  cohortId  String
  userId    String
  createdAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
}

model Enrollment {
  id        String           @id @default(cuid())
  courseId  String
  userId    String
  cohortId  String?
  method    EnrollmentMethod
  createdAt DateTime         @default(now())

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([courseId, userId])
}

enum EnrollmentMethod {
  COHORT_SYNC
  MANUAL
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contents    Content[]
  quizzes            Quiz[]
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  forumThreads       ForumThread[]

  @@index([courseId])
}

model Content {
  id        String      @id @default(cuid())
  title     String
  type      ContentType
  body      String?     @db.Text
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  order     Int         @default(0)
  moduleId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

enum ContentType {
  TEXT
  FILE
  VIDEO
}

model Quiz {
  id               String   @id @default(cuid())
  title            String
  description      String?
  moduleId         String
  duration         Int?
  deadline         DateTime?
  shuffleQuestions Boolean  @default(false)
  shuffleOptions   Boolean  @default(false)
  questionsPerPage Int      @default(0) // 0 = all on one page, 1 = 1 per page (Moodle-style)
  isPublished      Boolean  @default(false)
  order            Int      @default(0)
  maxAttempts      Int?     @default(1)  // null = unlimited
  passingGrade     Float?               // null = no passing grade (0-100)
  useQuestionBank  Boolean  @default(false)
  requireToken     Boolean  @default(false)
  token            String?
  enableLockdown   Boolean  @default(false)
  maxTabSwitches   Int      @default(3)
  isRemedial       Boolean  @default(false)
  parentQuizId     String?
  targetStudentIds Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  module                Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  parentQuiz            Quiz?               @relation("QuizRemedials", fields: [parentQuizId], references: [id], onDelete: SetNull)
  remedials             Quiz[]              @relation("QuizRemedials")
  questions             QuizQuestion[]
  attempts              QuizAttempt[]
  questionBankSelections QuizBankSelection[]

  @@index([moduleId])
  @@index([parentQuizId])
}

model QuizQuestion {
  id       String       @id @default(cuid())
  quizId   String
  type     QuestionType
  text     String       @db.Text
  options  Json?
  points   Float        @default(1)
  order    Int          @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_CHOICE_COMPLEX
  ESSAY
}

model QuizAttempt {
  id                String    @id @default(cuid())
  quizId            String
  userId            String
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  score             Float?
  isGraded          Boolean   @default(false)
  questionSnapshot  Json?     // Snapshot of randomly selected questions for bank-soal mode
  tabSwitchCount    Int       @default(0)
  isTerminated      Boolean   @default(false)
  terminationReason String?
  extraTimeMinutes  Int       @default(0)
  lastActiveAt      DateTime  @default(now())
  deviceInfo        String?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
  answers QuizAnswer[]

  @@index([quizId])
  @@index([userId])
}

model QuizAnswer {
  id          String  @id @default(cuid())
  attemptId   String
  questionId  String
  answer      String? @db.Text
  score       Float?
  teacherNote String?

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])

  @@index([attemptId])
}

model Assignment {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  moduleId     String
  deadline     DateTime?
  maxFileSize  Int?
  allowedTypes String?
  maxScore     Float    @default(100)
  isPublished  Boolean  @default(false)
  order        Int      @default(0)
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module      Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([moduleId])
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  userId       String
  fileUrl      String
  fileName     String
  fileSize     Int
  submittedAt  DateTime  @default(now())
  score        Float?
  teacherNote  String?   @db.Text
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([assignmentId])
  @@index([userId])
}

model Grade {
  id        String    @id @default(cuid())
  courseId  String
  userId    String
  label     String
  score     Float
  maxScore  Float     @default(100)
  type      GradeType
  sourceId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([courseId])
  @@index([userId])
}

enum GradeType {
  QUIZ
  ASSIGNMENT
  MANUAL
  ATTENDANCE
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestionBankCategory {
  id        String   @id @default(cuid())
  name      String
  courseId   String
  createdAt DateTime @default(now())

  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuestionBank[]
  quizBankSelections QuizBankSelection[]

  @@index([courseId])
}

model QuestionBank {
  id         String       @id @default(cuid())
  courseId    String
  categoryId String?
  type       QuestionType
  text       String       @db.Text
  options    Json?
  points     Float        @default(1)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  course   Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category QuestionBankCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([categoryId])
}

model QuizBankSelection {
  id         String @id @default(cuid())
  quizId     String
  categoryId String
  count      Int

  quiz     Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  category QuestionBankCategory @relation(fields: [categoryId], references: [id])

  @@index([quizId])
}

model AttendanceSession {
  id               String             @id @default(cuid())
  courseId         String
  moduleId         String?
  title            String
  date             DateTime           @default(now())
  startTime        DateTime?
  endTime          DateTime?
  token            String?
  allowSelfCheckin Boolean            @default(true)
  isOpen           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   Module?            @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  records  AttendanceRecord[]

  @@index([courseId])
  @@index([moduleId])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  userId    String
  status    AttendanceStatus @default(ABSENT)
  checkInAt DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

enum AttendanceStatus {
  PRESENT
  SICK
  PERMISSION
  ABSENT
}

model CourseAnnouncement {
  id        String                @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  content   String                @db.Text
  isPinned  Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  course   Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author   User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments AnnouncementComment[]

  @@index([courseId])
  @@index([authorId])
}

model AnnouncementComment {
  id             String             @id @default(cuid())
  announcementId String
  authorId       String
  content        String             @db.Text
  createdAt      DateTime           @default(now())

  announcement CourseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([authorId])
}

model ForumThread {
  id        String         @id @default(cuid())
  courseId  String
  moduleId  String?
  authorId  String
  title     String
  content   String         @db.Text
  isPinned  Boolean        @default(false)
  isSolved  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments ForumComment[]

  @@index([courseId])
  @@index([moduleId])
  @@index([authorId])
}

model ForumComment {
  id        String         @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  content   String         @db.Text
  isAnswer  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  thread   ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ForumComment?  @relation("NestedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumComment[] @relation("NestedReplies")

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  badgeCode     String
  badgeName     String
  badgeCategory String
  icon          String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeCode])
  @@index([userId])
}

model XpLog {
  id         String   @id @default(cuid())
  userId     String
  courseId   String?
  amount     Int
  reason     String
  actionType String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  courseId    String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, courseId])
}

enum CalendarEventScope {
  SCHOOL
  COURSE
  PERSONAL
}

enum CalendarEventCategory {
  ACADEMIC
  EXAM
  HOLIDAY
  MEETING
  OTHER
}

model CalendarEvent {
  id          String                 @id @default(cuid())
  title       String
  description String?                @db.Text
  startDate   DateTime
  endDate     DateTime?
  isAllDay    Boolean                @default(false)
  scope       CalendarEventScope     @default(PERSONAL)
  category    CalendarEventCategory  @default(ACADEMIC)
  color       String?                // e.g. blue, emerald, amber, rose, purple
  location    String?

  courseId    String?
  course      Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)

  creatorId   String
  creator     User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([startDate, endDate])
  @@index([scope, courseId])
  @@index([creatorId])
}

enum AnnouncementTarget {
  ALL
  TEACHER
  STUDENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model SchoolAnnouncement {
  id          String                @id @default(cuid())
  schoolId    String
  authorId    String
  title       String
  content     String                @db.Text
  targetRole  AnnouncementTarget    @default(ALL)
  priority    AnnouncementPriority  @default(NORMAL)
  isPinned    Boolean               @default(false)
  isActive    Boolean               @default(true)
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author      User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([targetRole])
  @@index([priority])
  @@index([createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  isGroup       Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // 'LOGIN_SUCCESS' | 'LOGIN_FAILED' | 'ACCOUNT_LOCKED' | 'ACCOUNT_UNLOCKED' | 'PASSWORD_CHANGED'
  ipAddress String?
  userAgent String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

